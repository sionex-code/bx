  if (a === 'eval' && r && r.value !== undefined) {
    const v = typeof r.value === 'string' ? r.value : JSON.stringify(r.value, null, 1);
    const cap = num(flags.max) || 20000;
    console.log(v.length > cap ? `${v.slice(0, cap)}\n${dim(`… ${v.length - cap} more characters (--max N)`)}` : v);
  }
  if (a === 'elements') {
