${bold('targets')}  ${dim('css  ·  text=Sign in  ·  ref=e12  ·  role=button:Save  ·  label=Email  ·  placeholder=Search  ·  name=q  ·  xpath=//a')}
         ${dim('several matches? bx picks the enabled one, prints "N matched" and lists the rest as refs.')}
         ${dim('narrow with  --has TEXT  --near SEL  --nth N,  or click the ref it showed you.')}
