      if (sub === 'set') {
        const patch = {};
        for (const a of args) { const [k, v] = a.split('='); patch[k] = /^[\d.]+$/.test(v) ? Number(v) : v === 'true' ? true : v === 'false' ? false : v; }
        const r = await api('POST', '/jev', patch);
        console.log(JSON.stringify(r.jev, null, 2));
        return;
      }
      if (sub === 'ask') {
        let questions;
        try { questions = JSON.parse(args.join(' ')); } catch { die(`bx jev ask '{"urgent":{"type":"noul","instructions":"..."}}'`); }
        const r = await api('POST', '/jev/ask', { questions, page: true, tab: common().tab, state: flags.state });
        console.log(JSON.stringify(r, null, 2));
        return;
      }
      const r = await api('GET', '/jev');
      if (flags.json) { console.log(JSON.stringify(r, null, 2)); return; }
      console.log(`${r.ready ? OK : BAD} jev ${r.enabled ? grn('on') : yel('off')}${r.ready ? '' : red('  no key — bx jev key sk-codiv-…')}`);
      console.log(`  ${dim('model')}      ${bold(r.model)}   ${dim(r.base)}`);
      if (r.key) console.log(`  ${dim('key')}        ${r.key} ${dim(`(${r.source})`)}`);
      console.log(`  ${dim('floor')}      ${r.min_confidence} ${dim('— below this the agent stops and hands back')}`);
      console.log(`  ${dim('used')}       ${r.usage.calls} calls${r.usage.failed ? red(`, ${r.usage.failed} failed`) : ''}${r.usage.calls ? dim(`, ${r.usage.avg_ms}ms avg, ${r.usage.input_tokens} input tokens`) : ''}`);
      return;
    }

    case 'open': case 'go': case 'nav': return run([{ a: 'nav', url: target() }]);
    case 'back': return run([{ a: 'back' }]);
    case 'forward': return run([{ a: 'forward' }]);
    case 'reload': return run([{ a: 'reload', hard: !!flags.hard }]);
    case 'info': return run([{ a: 'info' }]);

    case 'click': case 'dblclick': case 'rclick': case 'hover': {
      const act = { a: cmd, target: target(), button: flags.button, clicks: num(flags.clicks) };
      if (flags.json || flags['no-wait']) return run([act]);
      // Say what the click did — where the page went, what opened — so the
      // next move is not "take a screenshot to see what happened". That
      // reflex cost the Fiverr run more than a minute: a shot, then the
      // model viewing the image, after nearly every click.
      const out = await api('POST', '/do', { ...common(), stopOnError: false, actions: [
        { a: 'info' }, { a: 'elements', max: 300 }, act,
        { a: 'wait', settle: true, quiet: 250, timeout: 2500 }, { a: 'info' }, { a: 'elements', max: 300 }
      ] });
      const [i0, e0, did, , i1, e1] = out.results || [];
      const before = new Set((e0?.r?.elements || []).map((e) => `${e.ref}|${e.name || ''}`));
      const fresh = (e1?.r?.elements || []).filter((e) => !before.has(`${e.ref}|${e.name || ''}`) && e.name);
      const gone = (e0?.r?.elements || []).length - (e1?.r?.elements || []).length + fresh.length;
      out.results = [did];
      const code = render(out);
      if (did?.ok) {
        const u0 = i0?.r?.url, u1 = i1?.r?.url;
        if (u1 && u1 !== u0) console.log(`  ${mag('→')} ${dim('now at')} ${u1}`);
        if (fresh.length) {
          console.log(`  ${mag('+')} ${dim(`${fresh.length} new on screen:`)}`);
          for (const e of fresh.slice(0, 15)) console.log(`    ${yel(e.ref.padEnd(5))} ${dim((e.tag || '').padEnd(8))} ${trunc(e.name, 70)}`);
          if (fresh.length > 15) console.log(dim(`    … ${fresh.length - 15} more — bx els`));
        } else if (!(u1 && u1 !== u0)) console.log(`  ${dim(gone > 0 ? `${gone} elements went away, nothing new appeared` : 'no visible change — nothing opened and the URL did not move')}`);
      }
      process.exit(code);
    }

    case 'type': return run([{ a: 'type', target: target(), text: args.slice(1).join(' '), enter: !!flags.enter, clear: flags.noclear ? false : undefined }]);
    case 'clear': return run([{ a: 'clear', target: target() }]);
    case 'press': return run([{ a: 'press', keys: args, target: flags.target }]);
    case 'select': return run([{ a: 'select', target: target(), value: args.slice(1).join(' ') }]);
    case 'check': case 'uncheck': return run([{ a: cmd, target: target() }]);
    case 'focus': return run([{ a: 'focus', target: target() }]);

    case 'fill': {
      const fields = {};
      for (const kv of args) { const i = kv.indexOf('='); if (i < 0) die(`fill wants sel=value, got "${kv}"`); fields[kv.slice(0, i)] = kv.slice(i + 1); }
      return run([{ a: 'fill', fields, fast: !!flags.fast }]);
    }

    case 'scroll': {
      const to = args[0];
      const a = { a: 'scroll', target: flags.target };
      if (to === 'bottom' || to === 'top') a.to = to;
      else if (to !== undefined && !isNaN(+to)) a.to = +to;
      if (flags.by) a.by = [0, num(flags.by)];
      if (flags.into) a.into = true;
      return run([a]);
    }

    case 'drag': return run([{ a: 'drag', target: target(), to: args[1] }]);

    case 'wait': {
      const a = { a: 'wait' };
      if (flags.ms) a.ms = num(flags.ms);
      else if (flags.gone) a.gone = typeof flags.gone === 'string' ? flags.gone : target();
      else if (flags.text) a.text = flags.text;
      else if (flags.load) a.load = true;
      else a.for = target();
      return run([a]);
    }

    case 'read': {
      const urls = args.filter((x) => /^https?:\/\//i.test(x));
      if (flags.file) urls.push(...fs.readFileSync(flags.file, 'utf8').split(/\s+/).filter((x) => /^https?:\/\//i.test(x)));
      if (urls.length) {
        if (urls.length > 40 && !flags.json) console.log(`  ${mag('▸')} ${dim(`jev: ${urls.length} pages is a lot to read — if you are going to keep only some, ${bold('bx sift "<criterion>" --pages N')} on the results list first, or ${bold('bx check "<question>" --file F')}, and read just the keepers`)}`);
        const code = await manyUrls('read', '/many/read', `${flags.mode || 'md'}|${flags.max || ''}`, urls, { mode: flags.mode, max: num(flags.max), fetch: flags['no-fetch'] ? false : undefined }, (x) => {
          if (x.error) { console.log(`\n${red('═══ err')} ${x.url}  ${dim(trunc(x.error, 60))}`); return; }
          console.log(`\n${bold('═══')} ${bold(trunc(x.title || '', 70))}  ${dim(`${x.via} ${secs(x.ms)}`)}\n${dim(x.url)}\n`);
          console.log(x.text);
        });
        process.exit(code);
      }
      return settled([{ a: 'read', target: target(), mode: flags.mode, max: num(flags.max) }]);
    }
    case 'els': case 'elements': return settled([{ a: 'elements', filter: args[0] || flags.filter, max: num(flags.max) }]);
    case 'exists': return run([{ a: 'exists', target: target(), timeout: num(flags.timeout) ?? 0 }]);

    case 'shot': case 'screenshot':
      return settled([{ a: 'shot', target: target(), fullPage: !!flags.full, format: flags.format, quality: num(flags.quality), maxWidth: num(flags.maxWidth) }]);

    case 'upload': return run([{ a: 'upload', target: target(), files: args.slice(1).map((f) => path.resolve(f)), viaDialog: !!flags.dialog }]);
    case 'eval': return run([{ a: 'eval', expr: args.join(' ') }]);
    case 'cookies': return run([{ a: 'cookies', values: !!flags.values }]);

    case 'tabs': return run([{ a: 'tabs' }]);
    case 'tab': return run([{ a: 'tab', id: /^\d+$/.test(args[0] || '') ? +args[0] : args.join(' ') }]);
    case 'newtab': return run([{ a: 'newtab', url: target(), active: flags.background ? false : true }]);
    case 'close': return run([{ a: 'closetab', id: args[0] ? +args[0] : undefined }]);

    default: die(`unknown command "${cmd}" — try ${bold('bx help')}`);
  }
}

main().catch((e) => die(e.message));
