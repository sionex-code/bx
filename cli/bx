        return;
      }
      const r = await api('GET', `/memory${args[0] ? `?host=${encodeURIComponent(args[0])}` : ''}`);
      if (flags.json) return void console.log(JSON.stringify(r.memory, null, 2));
      if (r.error) die(r.error);
      if (!r.digest) return void console.log(dim(`  nothing known about ${r.host || 'this site'} yet`));
      recall(r.digest, true);
      const m = r.memory;
      console.log(dim(`\n  ${m.runs} batches since ${new Date(m.first).toLocaleDateString()}  ${DOT}  ${Object.keys(m.sel).length} selectors  ${DOT}  ${m.traces.length} flows`));
      return;
    }

    case 'note': {
      const text = args.join(' ');
      if (!text) die('note what?');
      const r = await api('POST', '/memory/note', { text, host: flags.host });
      if (!r.ok) die(r.error);
      console.log(`${OK} noted for ${bold(r.host)} ${dim(`(${r.notes} notes)`)}`);
      return;
    }

    case 'learn': {
      const name = args[0];
      if (!name) die('learn what? give the flow a name, e.g. bx learn login');
      const r = await api('POST', '/memory/learn', { name, host: flags.host, index: num(flags.back), last: num(flags.last), note: flags.note === true ? undefined : flags.note });
      if (!r.ok) die(r.error);
      console.log(`${OK} ${bold(r.host)} knows ${bold(r.name)} ${dim(`— ${r.steps} steps`)}`);
      console.log(`    ${dim(r.flow)}`);
      console.log(dim(`    replay: bx recipe ${r.name}${r.vars.map((v) => ` '${v}=…'`).join('')}`));
      // A flow driven one command at a time is not any single batch, so the
      // newest batch is often not the flow. Show what was done, numbered, so
      // a wrong pick is fixed in one more command rather than discovered on
      // replay.
      if (!flags.last && r.recent && r.recent.length > r.steps) {
        console.log(`
  ${mag('▸')} ${dim('recent actions on this site — if the flow is the last N of these, run')} ${bold(`bx learn ${r.name} --last N`)}`);
        for (const l of r.recent) console.log(`    ${dim(l)}`);
      }
      return;
    }

    case 'recipe': case 'replay': {
      const name = args.shift();
      if (!name) die('replay what? bx memo shows the recipes for this site');
      const vars = {};
      // A URL runs the flow on that page instead of the one it was learned on.
      const url = args.length && /^https?:\/\//i.test(args[0]) ? args.shift() : undefined;
      for (const kv of args) { const i = kv.indexOf('='); if (i < 0) die(`recipe wants name=value, got "${kv}"`); vars[kv.slice(0, i)] = kv.slice(i + 1); }
      const out = await api('POST', '/do', { ...common(), recipe: name, vars, url, host: flags.host, force: !!flags.force });
      process.exit(render(out));
    }

    case 'forget': {
      // No default. A bare `bx forget` used to mean "all" and silently wiped
      // everything learned about the current site.
      const what = args[0];
      if (!what) die(`forget what? ${bold('bx forget all|notes|traces|traps|selectors|recipe <name>')}  ${dim('--host H, default: this tab')}`);
      const r = await api('POST', '/memory/forget', { what, name: args[1], host: flags.host || (what === 'all' ? args[1] : undefined) });
      if (!r.ok) die(r.error);
      console.log(`${OK} forgot ${bold(r.name || r.forgot)}${r.host ? dim(` on ${r.host}`) : ''}`);
      return;
    }

    // ── jev ──────────────────────────────────────────────────────────────
    case 'agent': {
      const goal = args.join(' ');
      if (!goal) die(`agent needs a goal — ${bold('bx agent "find the pricing page and screenshot it"')}`);
      const vars = {};
      for (let i = 0; i < argv.length; i++) {
        if (argv[i] === '--var' && argv[i + 1]) { const [k, ...r] = argv[++i].split('='); vars[k] = r.join('='); }
      }
      const useJev = !(flags['no-jev'] || flags.nojev || flags.brain === 'local' || flags.brain === 'off');
      const payload = {
        ...common(), goal, hint: flags.hint, vars, jev: useJev,
        maxSteps: num(flags.steps), dry: !!flags.dry, min_confidence: num(flags.confidence), allow: !!flags.yes, see: see(),
        read: flags.read ? (num(flags.read) || true) : undefined
      };
      if (flags.json) { const out = await api('POST', '/agent', payload); console.log(JSON.stringify(out, null, 2)); process.exit(out.ok ? 0 : 1); }
      console.log(`${mag('▸ agent')} ${bold(trunc(goal, 70))}  ${dim(useJev ? 'brain jev' : 'brain local (no jev)')}`);
      const steps = [];
      const out = await stream('/agent', { ...payload, stream: true }, (ev) => { steps.push(ev); stepLine(ev); });
      process.exit(agentEnd({ ...out, steps }));
    }

    case 'pick': {
      const want = args.join(' ');
      if (!want) die(`pick needs a description — ${bold('bx pick "the search box"')}`);
      const r = await api('POST', '/jev/pick', { want, tab: common().tab, max: num(flags.max), see: see() });
      if (flags.json) { console.log(JSON.stringify(r, null, 2)); process.exit(r.ok ? 0 : 1); }
      if (!r.ok) die(r.error || 'no match');
      console.log(`${OK} ${yel(r.ref.padEnd(5))} ${trunc(r.label, 60)}  ${pct(r.confidence)} ${dim(secs(r.ms))}${eye(r)}`);
      if (r.sel) console.log(`  ${dim('selector')} ${blu(r.sel)}`);
      for (const a of r.alternatives || []) console.log(`  ${dim('also')} ${yel(a.label.padEnd(5))} ${dim(`${Math.round(a.p * 100)}%`)}`);
      return;
    }

    case 'check': {
      // URLs anywhere in the arguments (or one per line in --file) turn this
      // into the parallel form: every page checked at once, none of them in
      // the user's tab.
      const urls = args.filter((x) => /^https?:\/\//i.test(x));
      if (flags.file) urls.push(...fs.readFileSync(flags.file, 'utf8').split(/\s+/).filter((x) => /^https?:\/\//i.test(x)));
      if (urls.length) {
        const q = args.filter((x) => !/^https?:\/\//i.test(x)).join(' ');
        if (!q) die(`check needs a question — ${bold('bx check "has an Anonymous post option" <url> <url> ...')}`);
        let yes = 0, unread = 0;
        const code = await manyUrls('check', '/jev/many', q, urls, { question: q, see: see(), fetch: flags['no-fetch'] ? false : undefined }, (x) => {
          if (x.error) { console.log(`${red('err')}  ${trunc(x.url, 70)}  ${dim(trunc(x.error, 60))}`); return; }
          const a = x.answers[0];
          if (x.unreadable) { unread++; console.log(`${yel('?? ')}  ${dim(' --')}  ${trunc(x.title || x.url, 58).padEnd(58)} ${dim(`${x.via} ${secs(x.ms)}`)}\n     ${dim(x.url)}\n     ${yel(`unknown — ${x.unreadable}`)}`); return; }
          if (a.answer) yes++;
          console.log(`${a.answer ? grn('yes') : red('no ')}  ${pct(a.answer ? a.p : 1 - (a.p ?? 0))}  ${trunc(x.title || x.url, 58).padEnd(58)} ${dim(`${x.via} ${secs(x.ms)}`)}${eye(x)}\n     ${dim(x.url)}`);
        });
        if (!flags.json && yes) console.log(dim(`${yes} yes in this call`));
        // Every page answered yes so far, this call and earlier ones.
        const sv = saveLinks((manyUrls.last || []).filter((x) => x.answers && x.answers[0]?.answer && !x.unreadable).map((x) => x.asked || x.url));
        if (!flags.json) savedLine(sv, sv && `bx read --file ${sv.file} --max 1500`);
        if (!flags.json && unread) console.log(`  ${mag('▸')} ${yel(`${unread} page${unread > 1 ? 's' : ''} could not be read`)} ${dim('— their answer is unknown, not no. Open one (bx open <url>) to see why: a login wall, an error, or a page that only renders after a click.')}`);
        process.exit(code);
      }
      const q = args.join(' ');
      if (!q) die(`check needs a question — ${bold('bx check "am I logged in"')}`);
      // --in: ask about one post, card or row instead of the whole page.
      const r = await api('POST', '/jev/check', { question: q, tab: common().tab, see: see(), in: typeof flags.in === 'string' ? flags.in : undefined });
      if (flags.json) { console.log(JSON.stringify(r, null, 2)); process.exit(r.ok ? 0 : 1); }
      if (!r.ok) die(r.error || 'check failed');
      if (r.unreadable) {
        console.log(`${yel('?? ')}  ${dim(`unknown — ${r.unreadable}. Nothing was judged; bx shot or bx read shows what is there.`)}`);
        process.exit(2);
      }
      for (const a of r.answers) {
        console.log(`${a.answer ? grn('yes') : red('no ')}  ${trunc(a.question, 60).padEnd(60)} ${pct(a.p === undefined ? a.confidence : (a.answer ? a.p : 1 - a.p))} ${dim(secs(r.ms))}${eye(r)}`);
      }
      process.exit(r.answers.every((a) => a.answer) ? 0 : 1);
    }

    case 'each': {
      // Journal per list + instructions: a rerun skips every row already
      // done or deliberately passed over, and retries the ones that failed.
      let doActs;
      if (flags.do !== undefined) {
        try { doActs = JSON.parse(flags.do); } catch (e) { die(`--do wants a JSON array of actions: ${e.message}`); }
        if (!Array.isArray(doActs)) doActs = [doActs];
      }
      if (!flags.if && !flags.check && !doActs && !flags.with && !flags.without) die(`each needs --if, --check and/or --do — ${bold(`bx each --if "<which rows>" --check "<question about the opened row>" --do '[…{{first}}…]'`)}`);
      const info = await api('POST', '/do', { ...common(), actions: [{ a: 'info' }] });
      const here = info.url || '';
      const key = JSON.stringify([here.split('#')[0], args[0] || '', flags.if || '', flags.check || '', flags.do || '', flags.with || '', flags.without || '']);
      const file = flags.out ? path.resolve(flags.out) : path.join(HOME, 'runs', `each-${require('crypto').createHash('sha1').update(key).digest('hex').slice(0, 12)}.jsonl`);
      const skip = new Set();
      if (!flags.fresh) {
        try {
          for (const l of fs.readFileSync(file, 'utf8').split('\n')) {
            try { const x = JSON.parse(l); if (x.key && (x.done || x.skip || (x.keep === false && x.by !== 'text'))) skip.add(x.key); } catch {}
          }
        } catch {}
      }
      try { fs.mkdirSync(path.dirname(file), { recursive: true }); } catch {}
      if (skip.size && !flags.json) console.log(dim(`resuming · ${skip.size} rows already handled, in ${file}`));
      if (flags.dry && !flags.json) console.log(dim('dry run — rows are opened and checked, --do is not run'));
      const budget = flags.budget === undefined ? 90 : Number(flags.budget);
      const rows = [];
      const end = await stream('/each', {
        tab: common().tab, target: args[0] || flags.target, if: flags.if, check: flags.check, do: doActs,
        with: typeof flags.with === 'string' ? flags.with : undefined, without: typeof flags.without === 'string' ? flags.without : undefined,
        max: num(flags.max), dry: !!flags.dry, see: see(), budget: budget ? budget * 1000 : 0, pick: common().pick,
        stopOnError: flags.keepgoing ? false : undefined, skip: [...skip]
      }, (x) => {
        delete x.t;
        rows.push(x);
        if (!flags.dry && (flags.check || doActs)) { try { fs.appendFileSync(file, JSON.stringify(x) + '\n'); } catch {} }
        if (flags.json) return;
        const who = trunc(x.name || x.href || '?', 44).padEnd(44);
        const t = x.ms ? dim(secs(x.ms)) : '';
        if (x.keep === false) console.log(`${dim('pass')}  ${dim(who)} ${dim(x.by === 'text' ? 'filtered out by --with/--without' : `not a match for --if (${Math.round((1 - (x.p ?? 0)) * 100)}% sure)`)}`);
        else if (x.error) console.log(`${BAD}     ${who} ${red(trunc(x.error, 70))}`);
        else if (x.skip) console.log(`${yel(x.check?.unknown ? '??  ' : 'skip')}  ${who} ${dim(x.check?.unknown ? `could not tell — ${x.check.why || 'page unreadable'}` : `check said no (${Math.round((1 - (x.check?.p ?? 0)) * 100)}%)`)} ${t}`);
        else if (x.dry) console.log(`${mag('would')} ${who} ${dim(x.check ? `check yes (${Math.round((x.check.p ?? 0) * 100)}%)` : '')} ${t}`);
        else if (x.done) console.log(`${OK}     ${who} ${t}`);
        else console.log(`${grn('match')} ${who} ${x.check ? dim(`check yes (${Math.round((x.check.p ?? 0) * 100)}%)`) : ''} ${t}`);
      });
      if (flags.json) { console.log(JSON.stringify({ ...end, journal: file, rows }, null, 2)); process.exit(end.ok ? 0 : 1); }
      if (end.ok === false && end.error) die(end.error);
      const listing = !flags.check && !doActs;
      console.log(dim(listing
        ? `\n${end.did} rows match · nothing was opened · ${secs(end.ms || 0)}`
        : `\n${end.did} done · ${end.skipped} skipped · ${end.failed} failed · ${end.rows} opened in ${secs(end.ms || 0)} · journal ${file}`));
      if (end.stopped === 'budget' || end.stopped === 'max') console.log(`  ${mag('▸')} ${bold('stopped at the ' + (end.stopped === 'budget' ? 'time budget' : '--max limit'))} ${dim('— run the exact same command again to continue; finished rows are skipped')}`);
      if (end.stopped === 'error') console.log(`  ${mag('▸')} ${yel('stopped at the first failed --do')} ${dim('— fix the batch, then run it again (finished rows are skipped), or add --keepgoing')}`);
      process.exit(end.ok && !end.failed ? 0 : 1);
    }

    case 'items': {
      // URLs: read the list off each of them in one command (bx items <url> <url> … --sort members).
      const urls = args.filter((x) => /^https?:\/\//i.test(x));
      if (flags.file) urls.push(...fs.readFileSync(flags.file, 'utf8').split(/\s+/).filter((x) => /^https?:\/\//i.test(x)));
      const tgt = args.find((x) => !/^https?:\/\//i.test(x)) || flags.target || (typeof flags.in === 'string' ? flags.in : undefined);
      if (typeof tgt === 'string' && /\s--\w/.test(tgt)) die(`"${tgt}" has flags inside the quotes — the target is only the CSS of the list: bx items ${bold('--sort members')}, not bx items 'x --sort members'`);
      const sort = typeof flags.sort === 'string' ? flags.sort : undefined;
      // Ranking, "--max 10" means "show me ten": models pass it that way, and
      // as a read cap it cut each scroll to ten rows and missed bigger ones.
      if (sort && flags.max !== undefined && flags.top === undefined) { flags.top = flags.max; delete flags.max; }
      const r = await api('POST', '/items', { ...common(), urls: urls.length ? urls : undefined, parallel: num(flags.parallel), fresh: !!flags.fresh, budget: urls.length ? (flags.budget === undefined ? 100 : Number(flags.budget)) * 1000 : undefined, target: tgt, max: num(flags.max) || 60, chars: num(flags.chars), pages: num(flags.pages), sort });
      if (flags.json) { console.log(JSON.stringify(r, null, 2)); process.exit(r.ok ? 0 : 1); }
      if (!r.ok) die(r.error || 'items failed');
      if (!r.n) die('no repeated list found — narrow it: bx items "<css of the list>"');
      // Flat, one row per entry: many lists pooled, or ranked by a number.
      if (r.items) {
        for (const x of r.sources || []) {
          if (x?.error) console.log(`${red('err')}  ${trunc(x.url, 80)}  ${dim(trunc(x.error, 70))}`);
          else if (x?.skipped) console.log(`${yel('skip')} ${trunc(x.url, 80)}  ${dim('out of time — run again with just those URLs')}`);
          else if (x) console.log(dim(`${String(x.n).padStart(3)} rows · ${x.pages} page${x.pages === 1 ? '' : 's'}${x.cached !== undefined ? ` · cached ${x.cached}s ago (--fresh to reload)` : ''} · ${trunc(x.url, 80)}`));
        }
        // No row had a number to rank by: the rows unranked beat an empty
        // answer after a minute of loading.
        const ranked = sort && r.items.some((x) => x.value != null);
        const show = ranked ? r.items.filter((x) => x.value != null) : r.items;
        const by = r.items[0]?.by === 'brackets' ? `the number in brackets — no row says "${sort}"` : sort;
        console.log(dim(`${r.n} rows${r.sources ? ` from ${r.sources.length} lists, repeats merged` : ''}${ranked ? ` · ranked by ${by}${show.length < r.items.length ? ` (${r.items.length - show.length} rows show no such number)` : ''}` : ''}${r.ms ? ` · ${secs(r.ms)}` : ''}`));
        if (sort && !ranked) console.log(`  ${mag('▸')} ${yel(`no row shows a number before "${sort}" — not ranked; read the counts off the rows below`)}`);
        const top = num(flags.top) || (sort ? 20 : show.length);
        show.slice(0, top).forEach((it, k) => console.log(`${yel(String(k + 1).padStart(3))}  ${ranked ? bold(String(it.value.toLocaleString()).padStart(11)) + '  ' : ''}${flags.chars ? it.text : trunc(it.text, 220)}${it.href ? `\n${' '.repeat(ranked ? 18 : 5)}${dim(it.href)}` : ''}`));
        if (show.length > top) console.log(dim(`  … ${show.length - top} more (--top N)`));
        savedLine(saveLinks(show.map((x) => x.href)));
        for (const n of r.notes || []) console.log(`  ${mag('▸ note')} ${dim(n)}`);
        return;
      }
      console.log(dim(`${r.n} items${r.pages > 1 ? ` across ${r.pages} pages` : ''}`));
      for (const p of r.results) {
        if (r.pages > 1) console.log(dim(`── page ${p.page}  ${p.url}`));
        for (const it of p.items) console.log(`${yel(String(it.i).padStart(3))}${it.ref ? ` ${dim(it.ref)}` : ''}  ${flags.chars ? it.text : trunc(it.text, 160)}${it.href ? `\n     ${dim(it.href)}` : ''}`);
      }
      savedLine(saveLinks(r.results.flatMap((p) => p.items.map((it) => it.href))));
      return;
    }

    case 'sift': {
      // URLs in the arguments (or --file): open each result list, page it and
      // judge it, all in this one command, keepers pooled without repeats.
      const urls = args.filter((x) => /^https?:\/\//i.test(x));
      if (flags.file) urls.push(...fs.readFileSync(flags.file, 'utf8').split(/\s+/).filter((x) => /^https?:\/\//i.test(x)));
      const criterion = args.filter((x) => !/^https?:\/\//i.test(x)).join(' ');
      if (!criterion) die(`sift needs a criterion — ${bold('bx sift "groups about home cooking with over 10k members"')}  ${dim('[<search url> …] --pages N --save keep.txt')}`);
      if (urls.length > 1 && !flags.json) console.log(dim(`${urls.length} lists · ${num(flags.parallel) === 1 ? 'one after another in bx\'s tab, jev judging each while the next loads' : `${Math.min(num(flags.parallel) || 6, urls.length)} at once in background tabs`}${flags.pages ? ` · up to ${flags.pages} pages each` : ''}`));
      const r = await api('POST', '/jev/sift', { criterion, urls: urls.length ? urls : undefined, parallel: num(flags.parallel), fresh: !!flags.fresh, budget: urls.length ? (flags.budget === undefined ? 100 : Number(flags.budget)) * 1000 : undefined, tab: common().tab, max: num(flags.max), target: flags.target, pages: num(flags.pages), all: !!flags.all, chars: num(flags.chars), see: see(), sort: typeof flags.sort === 'string' ? flags.sort : undefined });
      if (flags.json) { const sv = r.ok ? saveLinks(r.items.filter((x) => x.keep).map((x) => x.href)) : null; console.log(JSON.stringify(sv ? { ...r, saved: sv } : r, null, 2)); process.exit(r.ok ? 0 : 1); }
      if (!r.ok) die(r.error || 'sift failed');
      for (const x of r.sources || []) {
        if (x?.error) console.log(`${red('err')}  ${trunc(x.url, 80)}  ${dim(trunc(x.error, 60))}`);
        else if (x?.skipped) console.log(`${yel('skip')} ${trunc(x.url, 80)}  ${dim('out of time — run the same command again')}`);
        else if (x) console.log(dim(`${String(x.kept).padStart(3)} of ${String(x.n).padEnd(3)} kept · ${x.pages} page${x.pages === 1 ? '' : 's'}${x.cached !== undefined ? ` · cached ${x.cached}s ago` : ''} · ${trunc(x.url, 80)}`));
      }
      if (r.unjudged) console.log(`${yel('▲ jev could not judge')} ${dim(`(${trunc(r.unjudged, 70)}) — rows marked ?? are unjudged: decide those yourself from their text, do not wait and retry`)}`);
      console.log(dim(`${r.kept} of ${r.n} kept${r.sources ? ` from ${r.sources.length} lists, repeats merged` : r.pages > 1 ? ` across ${r.pages} pages` : ''} · ${secs(r.ms)}`) + eye(r));
      for (const it of r.items) {
        const mark = it.keep === null ? yel('?? ') + ' ' : it.keep ? grn('keep') : dim('drop');
        console.log(`${mark} ${it.keep === null ? dim('  --') : pct(it.keep ? it.p : 1 - (it.p ?? 0))}  ${yel(`${r.pages > 1 ? `p${it.page}·` : ''}${it.i}`.padStart(2))}  ${trunc(it.text, 130)}${it.href ? `\n                ${dim(it.href)}` : ''}`);
      }
      const sv = saveLinks(r.items.filter((x) => x.keep).map((x) => x.href));
      savedLine(sv, sv && `bx check "<question>" --file ${sv.file} --save yes.txt`);
      if (!sv && r.kept > 3 && r.items.some((x) => x.href)) console.log(`  ${mag('▸')} ${dim('add')} ${bold('--save keep.txt')} ${dim('to put the kept links in a file for')} ${bold('bx check "<q>" --file keep.txt')} ${dim('— no script needed')}`);
      // One search at a time, a model turn each: the many-URL form does them all.
      if (!urls.length) {
        const file = path.join(HOME, 'sifts.json');
        let trail = [];
        try { trail = JSON.parse(fs.readFileSync(file, 'utf8')); } catch {}
        const now = Date.now();
        trail = trail.filter((t) => now - t < 240000).concat(now).slice(-10);
        try { fs.writeFileSync(file, JSON.stringify(trail)); } catch {}
        if (trail.length >= 2) console.log(`  ${mag('▸')} ${dim('more searches to go? one command does them all:')} ${bold(`bx sift "${trunc(criterion, 40)}" "<url1>" "<url2>" … --pages N --save keep.txt`)}`);
      }
      if (r.skipped?.length) console.log(`  ${mag('▸')} ${bold(`${r.skipped.length} lists left`)} ${dim('— out of time; run the same command with just those URLs')}`);
      process.exit(r.kept || r.unjudged ? 0 : 1);
    }

    case 'jev': {
      const sub = args.shift();
      if (sub === 'key' || sub === 'add') {
        const k = (args[0] && args[0] !== '-' ? args[0] : null) || (typeof flags.key === 'string' ? flags.key : null) || await secret('paste the key (hidden): ');
        if (!k) die('bx jev key   (asks for it)  or  … | bx jev key -    TypeSafe apikey_… or codiv sk-codiv-…  --label NAME --provider typesafe|codiv');
        const r = await api('POST', '/jev/keys', { key: k, label: typeof flags.label === 'string' ? flags.label : undefined, provider: flags.provider, test: flags['no-test'] ? false : undefined });
        if (!r.ok) die(r.error);
        if (r.existing) { console.log(`${OK} already there as ${bold(r.label)} ${dim(`(${r.provider}, ${r.id})`)}`); return; }
        console.log(`${OK} ${bold(r.label)} added ${dim(`— ${r.provider}, id ${r.id}, stored in ${CFG_PATH} (0600)`)}`);
        if (r.test) console.log(r.test.ok ? `  ${dim(`works: ${r.test.model} answered in ${r.test.ms}ms`)}` : `  ${yel('▲ saved, but the test call failed:')} ${dim(r.test.error)}`);
        console.log(`  ${routeLine(r.jev)}`);
        return;
      }
      if (sub === 'keys') {
        const r = await api('GET', '/jev');
        if (flags.json) { console.log(JSON.stringify(r.keys, null, 2)); return; }
        printKeys(r.keys);
        return;
      }
      if (sub === 'rm' || sub === 'remove') {
        if (!args[0]) die('bx jev rm <id | label | last 4 characters>   (bx jev keys lists them)');
        const r = await api('POST', '/jev/keys/remove', { id: args[0] });
        if (!r.ok) die(r.error);
        console.log(`${OK} removed ${bold(r.removed.label)} ${dim(`(${r.removed.provider})`)}`);
        console.log(`  ${routeLine(r.jev)}`);
        return;
      }
      if (sub === 'use') {
        if (!['auto', 'typesafe', 'codiv'].includes(args[0])) die('bx jev use auto|typesafe|codiv');
        const r = await api('POST', '/jev', { provider: args[0] });
        if (!r.ok) die(r.error);
        console.log(`${OK} ${bold(args[0])}  ${routeLine(r.jev)}`);
        return;
      }
      if (sub === 'on' || sub === 'off') { await api('POST', '/jev', { enabled: sub === 'on' }); console.log(`${OK} jev ${sub}`); return; }
      if (sub === 'model') {
        if (!args[0]) die('bx jev model <name>   e.g. jev-1.13.0 (TypeSafe), openjev-0.1 (codiv)');
        const r = await api('POST', '/jev', { model: args[0] });
        if (!r.ok) die(r.error);
        for (const [p, v] of Object.entries(r.jev.providers)) console.log(`  ${p.padEnd(9)} ${bold(v.model)}`);
        return;
      }
      if (sub === 'set') {
        const patch = {};
        for (const a of args) { const [k, v] = a.split('='); patch[k] = /^[\d.]+$/.test(v) ? Number(v) : v === 'true' ? true : v === 'false' ? false : v; }
        const r = await api('POST', '/jev', patch);
        if (!r.ok) die(r.error);
        const { keys, usage, ...rest } = r.jev;
        console.log(JSON.stringify(rest, null, 2));
        return;
      }
      if (sub === 'ask') {
        let questions;
        try { questions = JSON.parse(args.join(' ')); } catch { die(`bx jev ask '{"urgent":{"type":"noul","instructions":"..."}}'`); }
        const r = await api('POST', '/jev/ask', { questions, page: true, tab: common().tab, state: flags.state, provider: flags.provider });
        console.log(JSON.stringify(r, null, 2));
        return;
      }
      if (sub) die(`bx jev ${sub}? — key, keys, rm, use, on, off, model, set, ask`);
      const r = await api('GET', '/jev');
      if (flags.json) { console.log(JSON.stringify(r, null, 2)); return; }
      console.log(`${r.ready ? OK : BAD} jev ${r.enabled ? grn('on') : yel('off')} ${DOT} ${bold(r.provider)}${r.ready ? '' : red('  no key — bx jev key')}`);
      console.log(`  ${routeLine(r)}`);
      for (const [p, v] of Object.entries(r.providers)) if (v.keys) console.log(`  ${dim(p.padEnd(9))}  ${v.model}  ${dim(v.base)}`);
      console.log(`  ${dim('keys')}`);
      printKeys(r.keys);
      console.log(`  ${dim('floor')}      ${r.min_confidence} ${dim('— below this the agent stops and hands back')}`);
      console.log(`  ${dim('parallel')}   ${r.parallel} calls at once ${dim(`— peak so far ${r.usage.peak || 0}${r.usage.inflight ? `, ${r.usage.inflight} in flight` : ''}; bx jev set parallel=N`)}`);
      console.log(`  ${dim('used')}       ${r.usage.calls} calls${r.usage.failed ? red(`, ${r.usage.failed} failed`) : ''}${r.usage.calls ? dim(`, ${r.usage.avg_ms}ms avg, ${r.usage.input_tokens} input tokens`) : ''}`);
      return;
    }

    // ── browsers: which one commands go to ──────────────────────────────
    case 'use': {
      if (!args[0]) die(`bx use <n | name | auto>   ${dim('— bx browsers lists them')}`);
      const r = await api('POST', '/browsers/use', { browser: args[0] });
      if (!r.ok) die(r.error);
      const b = r.chosen;
      console.log(b ? `${OK} commands go to ${bold(b.label ? `${b.browser} "${b.label}"` : b.browser)} ${dim(`(${b.iid}) — bx use auto to undo, --browser for one command`)}` : `${OK} ${bold('auto')} ${dim('— commands go to the browser last in use')}`);
      return;
    }
    case 'browsers': case 'browser': {
      if (args[0] === 'name' || args[0] === 'label') {
        if (!args[1]) die('bx browsers name <n> <label>');
        const r = await api('POST', '/browsers/name', { browser: args[1], label: args.slice(2).join(' ') });
        if (!r.ok) die(r.error);
        console.log(`${OK} named`);
        args.length = 0;
      } else if (args[0]) {
        const r = await api('POST', '/browsers/use', { browser: args[0] });
        if (!r.ok) die(r.error);
      }
      const r = await api('GET', '/browsers');
      if (flags.json) { console.log(JSON.stringify(r, null, 2)); return; }
      if (!r.browsers.length) die('no browser connected — load extension/ at chrome://extensions');
      for (const b of r.browsers) {
        const name = b.label ? `${b.browser} "${b.label}"` : b.browser || 'browser';
        console.log(`${b.primary ? grn('*') : ' '} ${bold(String(b.n))}  ${name.padEnd(20)} ${dim(`${plural(b.windows, 'window')}, ${plural(b.tabs, 'tab')} · ${b.iid}`)}${b.primary ? grn(b.chosen ? '  ← commands go here (chosen)' : '  ← commands go here (last in use)') : ''}`);
      }
      if (r.browsers.length > 1) console.log(dim(`\n  bx use <n>: always that one · bx use auto: the one last in use · --browser <n|name>: one command`));
      return;
    }

    // ── extensions: which browsers may connect ──────────────────────────
    case 'ext': {
      const sub = args.shift();
      if (sub === 'allow' || sub === 'forget') {
        if (!args[0]) die(`bx ext ${sub} <extension id>   (bx ext lists them)`);
        const r = await api('POST', `/ext/${sub}`, { id: args[0] });
        if (!r.ok) die(r.error);
        console.log(`${OK} ${sub === 'allow' ? 'allowed — that browser connects within a few seconds' : 'no longer allowed'}`);
        return;
      }
      if (sub) die(`bx ext ${sub}? — allow <id>, forget <id>`);
      const r = await api('GET', '/ext');
      if (flags.json) { console.log(JSON.stringify(r, null, 2)); return; }
      console.log(`${bold('connected')}`);
      if (!r.browsers.length) console.log(`  ${dim('none')}`);
      for (const b of r.browsers) console.log(`  ${(b.browser || '?').padEnd(10)} ${dim(`profile ${b.iid}`)}  ${plural(b.windows, 'window')}, ${plural(b.tabs, 'tab')}${b.primary ? grn('  ← commands go here') : ''}  ${dim(b.ext || '')}`);
      console.log(`${bold('allowed')}`);
      for (const id of r.allowed) console.log(`  ${id}`);
      if (r.refused.length) {
        console.log(`${bold('refused')} ${dim('— bx loaded from another folder has another id')}`);
        for (const x of r.refused) console.log(`  ${yel(x.id)}  ${dim(`${x.browser || ''}, ${x.tries} tries`)}  ${dim('→')} bx ext allow ${x.id}`);
      }
      return;
    }

    case 'open': case 'go': case 'nav': return run([{ a: 'nav', url: target() }]);
    case 'back': return run([{ a: 'back' }]);
    case 'forward': return run([{ a: 'forward' }]);
    case 'reload': return run([{ a: 'reload', hard: !!flags.hard }]);
    case 'info': return run([{ a: 'info' }]);

    case 'click': case 'dblclick': case 'rclick': case 'hover': {
      const act = { a: cmd, target: target(), button: flags.button, clicks: num(flags.clicks) };
      if (flags.json || flags['no-wait']) return run([act]);
      // Say what the click did — where the page went, what opened — so the
      // next move is not "take a screenshot to see what happened". That
      // reflex cost the Fiverr run more than a minute: a shot, then the
      // model viewing the image, after nearly every click.
      const out = await api('POST', '/do', { ...common(), stopOnError: false, actions: [
        { a: 'info' }, { a: 'elements', max: 300 }, ...scoped([act]),
        { a: 'wait', settle: true, quiet: 250, timeout: 2500 }, { a: 'info' }, { a: 'elements', max: 300 }
      ] });
      let [i0, e0, did, , i1, e1] = out.results || [];
      // A link to a big page (Wikipedia's Pakistan article) is still loading
      // when the settle wait ends, so the "after" look was taken of the page
      // being left: bx said "the URL did not move", the model clicked again,
      // and the stale ref landed on the next page's "Division" link.
      if (did?.ok && did.r?.hit === 'a' && i1?.r?.url === i0?.r?.url) {
        for (const end = Date.now() + 3000; Date.now() < end;) {
          await new Promise((r) => setTimeout(r, 200));
          const i = (await api('POST', '/do', { ...common(), actions: [{ a: 'info' }] })).results?.[0];
          if (i?.ok && i.r?.url && i.r.url !== i0?.r?.url) {
            const more = (await api('POST', '/do', { ...common(), stopOnError: false, actions: [
              { a: 'wait', settle: true, quiet: 250, timeout: 2500 }, { a: 'elements', max: 300 }] })).results || [];
            i1 = i; e1 = more[1];
            break;
          }
        }
      }
      const before = new Set((e0?.r?.elements || []).map((e) => `${e.ref}|${e.name || ''}`));
      const fresh = (e1?.r?.elements || []).filter((e) => !before.has(`${e.ref}|${e.name || ''}`) && e.name);
      const gone = (e0?.r?.elements || []).length - (e1?.r?.elements || []).length + fresh.length;
      out.results = [did];
      const code = render(out);
      if (did?.ok) {
        const u0 = i0?.r?.url, u1 = i1?.r?.url;
        if (u1 && u1 !== u0) console.log(`  ${mag('→')} ${dim('now at')} ${u1}`);
        if (fresh.length) {
          console.log(`  ${mag('+')} ${dim(`${fresh.length} new on screen:`)}`);
          // A navigation "adds" the whole next page; listing 77 of those
          // is a page dump in disguise. The first few say what opened.
          for (const e of fresh.slice(0, 8)) console.log(`    ${yel(e.ref.padEnd(5))} ${dim((e.tag || '').padEnd(8))} ${trunc(e.name, 60)}`);
          if (fresh.length > 8) console.log(dim(`    … ${fresh.length - 8} more — bx els "<css>" or bx pick "<what you want>"`));
        } else if (!(u1 && u1 !== u0)) console.log(`  ${dim(gone > 0 ? `${gone} elements went away, nothing new appeared` : 'no visible change — nothing opened and the URL did not move')}`);
      }
      process.exit(code);
    }

    case 'type': return run([
      { a: 'type', target: target(), text: args.slice(1).join(' '), enter: !!flags.enter, clear: flags.noclear ? false : undefined },
      // --send: press the send button next to the box, and the bridge checks
      // the text actually left it.
      ...(flags.send ? [{ a: 'send', target: target() }] : [])
    ]);
    case 'send': return run([{ a: 'send', target: args[0] ? target() : undefined }]);
    case 'clear': return run([{ a: 'clear', target: target() }]);
    case 'press': return run([{ a: 'press', keys: args, target: flags.target }]);
    case 'select': return run([{ a: 'select', target: target(), value: args.slice(1).join(' ') }]);
    case 'check': case 'uncheck': return run([{ a: cmd, target: target() }]);
    case 'focus': return run([{ a: 'focus', target: target() }]);

    case 'fill': {
      const fields = {};
      for (const kv of args) { const i = kv.indexOf('='); if (i < 0) die(`fill wants sel=value, got "${kv}"`); fields[kv.slice(0, i)] = kv.slice(i + 1); }
      return run([{ a: 'fill', fields, fast: !!flags.fast }]);
    }

    case 'scroll': {
      const to = args[0];
      const a = { a: 'scroll', target: flags.target };
      // "bx scroll 3" means three screens to everyone who types it; it used
      // to mean "to pixel 3". Small numbers are screens (negative: up),
      // `down`/`up` [N] too; a big number is still a pixel position.
      if (to === 'bottom' || to === 'top') a.to = to;
      else if (to === 'down' || to === 'up') a.screens = (num(args[1]) || 1) * (to === 'up' ? -1 : 1);
      else if (to !== undefined && !isNaN(+to) && Math.abs(+to) < 100) a.screens = +to;
      else if (to !== undefined && !isNaN(+to)) a.to = +to;
      if (flags.by) a.by = [0, num(flags.by)];
      if (flags.into) a.into = true;
      return run([a]);
    }

    case 'drag': return run([{ a: 'drag', target: target(), to: args[1] }]);

    case 'wait': {
      const a = { a: 'wait' };
      // "bx wait 1500" and "bx wait ms=1500" are how people write a pause.
      const bare = /^(?:ms=)?(\d+)$/.exec(args[0] || '');
      if (flags.ms) a.ms = num(flags.ms);
      else if (bare && !flags.gone && !flags.text) a.ms = +bare[1];
      else if (flags.gone) a.gone = typeof flags.gone === 'string' ? flags.gone : target();
      else if (flags.text) a.text = flags.text;
      else if (flags.load) a.load = true;
      else a.for = target();
      return run([a]);
    }

    case 'read': {
      const urls = args.filter((x) => /^https?:\/\//i.test(x));
      if (flags.file) urls.push(...fs.readFileSync(flags.file, 'utf8').split(/\s+/).filter((x) => /^https?:\/\//i.test(x)));
      if (urls.length) {
        if (urls.length > 40 && !flags.json) console.log(`  ${mag('▸')} ${dim(`jev: ${urls.length} pages is a lot to read — if you are going to keep only some, ${bold('bx sift "<criterion>" --pages N')} on the results list first, or ${bold('bx check "<question>" --file F')}, and read just the keepers`)}`);
        const code = await manyUrls('read', '/many/read', `${flags.mode || 'md'}|${flags.max || ''}`, urls, { mode: flags.mode, max: num(flags.max), fetch: flags['no-fetch'] ? false : undefined }, (x) => {
          if (x.error) { console.log(`\n${red('═══ err')} ${x.url}  ${dim(trunc(x.error, 60))}`); return; }
          console.log(`\n${bold('═══')} ${bold(trunc(x.title || '', 70))}  ${dim(`${x.via} ${secs(x.ms)}`)}\n${dim(x.url)}\n`);
          if (x.links) for (const l of x.links) console.log(`  ${trunc(l.text, 44).padEnd(44)} ${dim(l.href)}`);
          else console.log(x.text);
        });
        process.exit(code);
      }
      return settled([{ a: 'read', target: target(), mode: flags.mode, max: num(flags.max) }]);
    }
    // 60 by default: a LinkedIn page lists 150, most of them the site's own
    // header and sidebars, and agents re-ran it after every click.
    case 'els': case 'elements': return settled([{ a: 'elements', filter: args[0] || flags.filter, max: num(flags.max) || 60 }]);
    case 'exists': return run([{ a: 'exists', target: target(), timeout: num(flags.timeout) ?? 0 }]);

    case 'shot': case 'screenshot':
      return settled([{ a: 'shot', target: target(), fullPage: !!flags.full, format: flags.format, quality: num(flags.quality), maxWidth: num(flags.maxWidth) }]);

    case 'upload': return run([{ a: 'upload', target: target(), files: args.slice(1).map((f) => path.resolve(f)), viaDialog: !!flags.dialog }]);
    case 'eval': return run([{ a: 'eval', expr: args.join(' ') }]);
    case 'cookies': return run([{ a: 'cookies', values: !!flags.values }]);

    case 'tabs': return run([{ a: 'tabs' }]);
    case 'tab': return run([{ a: 'tab', id: /^\d+$/.test(args[0] || '') ? +args[0] : args.join(' ') }]);
    case 'newtab': return run([{ a: 'newtab', url: target(), active: flags.background ? false : true }]);
    case 'close': return run([{ a: 'closetab', id: args[0] ? +args[0] : undefined }]);

    default: die(`unknown command "${cmd}" — try ${bold('bx help')}`);
  }
}

main().catch((e) => die(e.message));
