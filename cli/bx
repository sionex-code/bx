#!/usr/bin/env node
'use strict';
// bx — the terminal face of the bridge. Auto-starts the bridge on first use,
// so an agent never has to think about lifecycle.
const http = require('http');
const fs = require('fs');
const os = require('os');
const path = require('path');
const { spawn } = require('child_process');

const ROOT = path.resolve(__dirname, '..');
// stdout to a pipe is asynchronous in Node, and every command ends in
// process.exit, which drops whatever is still queued: `bx items --pages 3
// --json | jq` lost everything past 64KB. Make the pipe blocking, so each
// write has landed before the next line runs and exiting loses nothing.
for (const s of [process.stdout, process.stderr]) {
  try { if (s._handle && typeof s._handle.setBlocking === 'function') s._handle.setBlocking(true); } catch {}
}

const HOME = process.env.BX_HOME || path.join(os.homedir(), '.bx');
const CFG_PATH = path.join(HOME, 'config.json');

// ── presentation ─────────────────────────────────────────────────────────
const TTY = process.stdout.isTTY && !process.env.NO_COLOR;
const c = (n) => (s) => (TTY ? `\x1b[${n}m${s}\x1b[0m` : String(s));
const dim = c('2'), bold = c('1'), red = c('31'), grn = c('32'), yel = c('33'), blu = c('36'), mag = c('35');
const OK = TTY ? grn('✓') : 'ok', BAD = TTY ? red('✗') : 'ERR', DOT = dim('·');

const trunc = (s, n) => { s = String(s ?? '').replace(/\s+/g, ' '); return s.length > n ? s.slice(0, n - 1) + '…' : s; };
const ms = (n) => dim(String(n).padStart(5) + 'ms');

function die(msg, code = 1) { console.error(`${BAD} ${msg}`); process.exit(code); }

// ── config / transport ───────────────────────────────────────────────────
function config() {
  try { return JSON.parse(fs.readFileSync(CFG_PATH, 'utf8')); }
  catch { return { port: 8787, token: null }; }
}

function req(method, route, body, port, token) {
  return new Promise((resolve, reject) => {
    const data = body === undefined ? null : Buffer.from(JSON.stringify(body));
    const r = http.request({
      host: '127.0.0.1', port, path: route, method,
      headers: Object.assign(
        { 'x-bx-token': token || '' },
        data ? { 'content-type': 'application/json', 'content-length': data.length } : {}
      )
    }, (res) => {
      let b = '';
      res.on('data', (x) => (b += x));
      res.on('end', () => { try { resolve({ code: res.statusCode, body: JSON.parse(b || '{}') }); } catch { resolve({ code: res.statusCode, body: { raw: b } }); } });
    });
    r.on('error', reject);
    r.setTimeout(180000, () => { r.destroy(new Error('request timeout')); });
    if (data) r.write(data);
    r.end();
  });
}

const alive = async (port) => { try { const r = await req('GET', '/health', undefined, port, ''); return r.body.up === true; } catch { return false; } };

async function ensureBridge(quiet) {
  const cfg = config();
  if (await alive(cfg.port)) return config();
  if (!quiet) process.stderr.write(dim('starting bridge…\n'));
  const child = spawn(process.execPath, [path.join(ROOT, 'bridge', 'server.js')], {
    detached: true, stdio: 'ignore', env: { ...process.env, BX_QUIET: '1' }
  });
  child.unref();
  for (let i = 0; i < 60; i++) {
    await new Promise((r) => setTimeout(r, 60));
    const c2 = config();
    if (await alive(c2.port)) return c2;
  }
  die('bridge failed to start');
}

async function api(method, route, body) {
  const cfg = await ensureBridge(true);
  const r = await req(method, route, body, cfg.port, cfg.token);
  if (r.code === 401) die('bad token — delete ~/.bx/config.json and retry');
  return r.body;
}

// An agent run is seconds of silence otherwise, and the interesting part is
// each decision as it happens, not the transcript afterwards.
async function stream(route, payload, online) {
  const cfg = await ensureBridge(true);
  const data = Buffer.from(JSON.stringify(payload));
  return new Promise((resolve, reject) => {
    const r = http.request({
      host: '127.0.0.1', port: cfg.port, path: route, method: 'POST',
      headers: { 'x-bx-token': cfg.token, 'content-type': 'application/json', 'content-length': data.length }
    }, (res) => {
      let buf = '';
      const last = { v: null };
      res.setEncoding('utf8');
      res.on('data', (c) => {
        buf += c;
        let i;
        while ((i = buf.indexOf('\n')) >= 0) {
          const line = buf.slice(0, i); buf = buf.slice(i + 1);
          if (!line.trim()) continue;
          let o; try { o = JSON.parse(line); } catch { continue; }
          if (o.t === 'end') last.v = o; else online(o);
        }
      });
      res.on('end', () => resolve(last.v || { ok: false, reason: 'no result' }));
    });
    r.on('error', reject);
    r.setTimeout(600000, () => r.destroy(new Error('agent timed out')));
    r.write(data); r.end();
  });
}

// ── arg parsing ──────────────────────────────────────────────────────────
const argv = process.argv.slice(2);
const flags = {};
const args = [];
for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  if (a.startsWith('--')) {
    const [k, v] = a.slice(2).split('=');
    flags[k] = v === undefined ? (argv[i + 1] && !argv[i + 1].startsWith('--') && ['tab', 'speed', 'timeout', 'max', 'mode', 'format', 'quality', 'to', 'by', 'nth', 'has', 'near', 'filter', 'host', 'back', 'note', 'steps', 'hint', 'brain', 'confidence', 'model', 'key', 'target', 'chars', 'pages', 'parallel', 'file', 'budget', 'out', 'last', 'if', 'check', 'do', 'with', 'without'].includes(k) ? argv[++i] : true) : v;
  } else args.push(a);
}
const num = (v) => (v === undefined ? undefined : Number(v));

const common = () => ({
  tab: flags.tab === undefined ? 'active' : /^\d+$/.test(flags.tab) ? Number(flags.tab) : flags.tab,
  speed: flags.speed,
  trusted: flags.trusted ? true : undefined,
  timeout: num(flags.timeout),
  inline: flags.inline ? true : undefined,
  stopOnError: flags.keepgoing ? false : undefined
});

// ── rendering ────────────────────────────────────────────────────────────
// A skill file is advice a model read once, possibly an old copy of it. The
// output of the command it just ran is read every time. So when a call is the
// slow way of doing something jev does in a second, say so right there.
function nudge(out) {
  const rs = (out.results || []).filter((r) => r.ok);
  if (rs.some((r) => r.a === 'read' && (r.r?.len || 0) > 1500 && !r.r?.links)) {
    return `jev: going through a list by reading it yourself is the slow path — ${bold('bx items')} returns it as items, ${bold('bx sift "<criterion>"')} keeps the matching ones in ~1s`;
  }
  // Opening page after page on one site is the one-by-one loop the batch
  // commands replace. Each CLI call is its own process, so the only way to
  // see the loop is a small trail on disk.
  const nav = rs.find((r) => r.a === 'nav');
  if (nav) {
    let host = '';
    try { host = new URL(nav.r?.url || '').host; } catch {}
    const file = path.join(HOME, 'opens.json');
    let trail = [];
    try { trail = JSON.parse(fs.readFileSync(file, 'utf8')); } catch {}
    const now = Date.now();
    trail = trail.filter((x) => now - x.at < 60000).concat(host ? [{ host, at: now }] : []).slice(-10);
    try { fs.writeFileSync(file, JSON.stringify(trail)); } catch {}
    if (host && trail.filter((x) => x.host === host).length >= 3) {
      return `jev: opening ${host} pages one by one — ${bold('bx check "<question>" <url> <url> …')} or ${bold('bx read <url> <url> …')} does them all at once in background tabs`;
    }
  }
  // Open, type, send, next: the per-item loop `bx each` replaces. The
  // LinkedIn inbox run did it by hand for nine conversations — seven minutes
  // of one command per model turn.
  const typed = rs.find((r) => r.a === 'type');
  if (typed) {
    const file = path.join(HOME, 'types.json');
    let trail = [];
    try { trail = JSON.parse(fs.readFileSync(file, 'utf8')); } catch {}
    const now = Date.now();
    let host = '';
    try { host = new URL(out.url || '').host; } catch {}
    trail = trail.filter((x) => now - x.at < 180000).concat(host ? [{ host, at: now }] : []).slice(-10);
    try { fs.writeFileSync(file, JSON.stringify(trail)); } catch {}
    if (host && trail.filter((x) => x.host === host).length >= 2) {
      return `jev: doing the same thing to one item after another — ${bold(`bx each --if "<which rows>" --check "<question about the open row>" --do '[…{{first}}…]'`)} runs the whole list in one command`;
    }
  }
  // Scroll, sleep, scroll, sleep, then items: the Facebook run did that 18
  // times by hand. --pages already scrolls a feed and waits for the new rows.
  if (rs.filter((r) => r.a === 'scroll').length >= 2) {
    return `jev: no need to scroll a feed by hand — ${bold('bx items --pages 5')} scrolls and collects in one call, ${bold('bx sift "<criterion>" --pages 5')} also keeps only the ones that fit`;
  }
  if (rs.some((r) => r.a === 'shot')) {
    return `jev: to answer a question about how the page looks, ${bold('bx check "<question>" --see')} is one ~3s call instead of reading the image yourself`;
  }
  if (rs.some((r) => r.a === 'elements') && (rs.find((r) => r.a === 'elements').r?.n || 0) > 25) {
    return `jev: ${bold('bx pick "<what you want>"')} chooses among these for you, and ${bold('bx agent "<goal>"')} runs the whole click-through`;
  }
  return null;
}

function render(out) {
  const hint = nudge(out);
  if (flags.json) { console.log(JSON.stringify(hint ? { ...out, hint: hint.replace(/\x1b\[[0-9;]*m/g, '') } : out, null, 2)); return out.ok ? 0 : 1; }
  if (out.error && !out.results) { console.error(`${BAD} ${out.error}`); return 1; }

  for (const r of out.results || []) {
    const head = `${r.ok ? OK : BAD} ${bold(r.a.padEnd(9))} ${ms(r.ms)}`;
    if (!r.ok) { console.log(`${head}  ${red(trunc(r.error, 140))}`); continue; }
    console.log(`${head}  ${summary(r.a, r.r)}${amb(r.r)}`);
    detail(r.a, r.r);
  }
  if ((out.results || []).length > 1) console.log(dim(`${DOT} ${out.results.length} actions in ${out.ms}ms  tab ${out.tab}`));
  if (out.memory) recall(out.memory);
  if (hint) console.log(`\n  ${mag('▸')} ${dim(hint)}`);
  return out.ok ? 0 : 1;
}

// What bx already knows about this site. It arrives unasked on arrival and on
// failure — the two moments an agent is about to rediscover it the slow way.
function recall(m, wide) {
  const row = (k, v, colour = dim) => console.log(`    ${mag(k.padEnd(7))} ${colour(v)}`);
  console.log(`\n  ${mag('▸ memory')} ${bold(m.host)}${m.for ? dim(`  (nothing on ${m.for}; using the parent domain)`) : ''}`);
  for (const r of m.recipes || []) {
    row('recipe', r.broken
      ? dim(`${r.name}  ${r.steps} steps · ${r.ok} ok · broken, do not replay`)
      : `${bold(r.name)}  ${r.steps} steps · ${r.ok} ok${r.path ? ` · ${r.path}` : ''}${r.vars ? dim(`  needs ${r.vars.join(' ')}`) : ''}`, (x) => x);
    if (wide) console.log(`            ${dim(r.flow)}`);
  }
  for (const u of m.urls || []) row('url', u, (x) => x);
  for (const t of m.traces || []) row('worked', `${t.flow}${dim(`   (${t.ms}ms${t.ran > 1 ? ` ×${t.ran}` : ''})`)}`);
  if (m.works) row('works', m.works.join(dim(' · ')), (x) => x);
  for (const a of m.avoid || []) row('avoid', a, yel);
  for (const t of m.traps || []) row('trap', t, yel);
  for (const n of m.notes || []) row('note', n, (x) => x);
}

// ── agent rendering ──────────────────────────────────────────────────────
// One line per decision. The percentage is jev's own confidence, and it is
// there because a 58% click and a 99% click are very different events.
const pct = (x) => {
  const n = Math.round((x || 0) * 100);
  const t = `${n}%`.padStart(4);
  return n >= 85 ? grn(t) : n >= 60 ? yel(t) : red(t);
};
const secs = (n) => (n >= 1000 ? `${(n / 1000).toFixed(1)}s` : `${n}ms`);

function stepLine(ev) {
  const d = ev.decided || {};
  const n = dim(String(ev.n).padStart(2));
  if (ev.stopped === 'done')    return console.log(`${n}  ${grn('done')}     ${dim('goal already satisfied')}  ${pct(d.confidence)}`);
  if (ev.stopped === 'blocked') return console.log(`${n}  ${red('blocked')}  ${dim('captcha / wall / hard error')}`);
  if (ev.stopped === 'finish')  return console.log(`${n}  ${yel('finish')}   ${dim('nothing here advances the goal')}`);
  if (ev.stopped === 'unsure')  return console.log(`${n}  ${yel('unsure')}   ${dim(`${d.verb || '?'} ${d.target || ''}`)}  ${pct(d.confidence)}`);
  if (ev.stopped === 'stuck')   return console.log(`${n}  ${yel('stuck')}    ${dim('same move three times, nothing changed')}`);
  if (ev.stopped === 'confirm') return console.log(`${n}  ${mag('confirm')}  ${dim(`wants to click ${trunc(ev.element || '', 44)}`)}  ${pct(d.confidence)}`);
  if (ev.stopped === 'needs-value') return console.log(`${n}  ${mag('needs')}    ${dim(`a value for ${trunc(ev.element || '', 44)}`)}  ${pct(d.confidence)}`);
  const what = d.verb === 'type' ? `"${trunc(d.text, 34)}" ${dim('→')} ${trunc(ev.element || '', 40)}` : trunc(ev.element || d.target || '', 56);
  const act = ev.dry ? dim('(dry run)') : ev.acted ? (ev.acted.ok ? `${OK} ${dim(secs(ev.acted.ms))}` : `${BAD} ${red(trunc(ev.acted.error, 60))}`) : '';
  console.log(`${n}  ${bold((d.verb || '?').padEnd(7))}  ${what.padEnd(58)} ${pct(d.confidence)} ${dim(secs(d.ms || 0).padStart(6))}  ${act}${eye(d)}`);
}

function agentEnd(out) {
  const mark = out.reason === 'done' ? grn('✓ done') : out.reason === 'unsure' ? yel('⊘ handing back') : out.reason === 'blocked' ? red('✗ blocked') : yel(`⊘ ${out.reason}`);
  console.log(`\n${mark}  ${dim(out.detail || '')}`);
  const st = out.steps || [];
  const think = st.reduce((a, x) => a + (x.decided?.ms || 0), 0);
  console.log(dim(`${DOT} ${st.length} steps · brain ${out.brain}${think ? ` · ${secs(think)} deciding` : ''}`));

  // The escalation. bx stopped because it was not sure enough, so the thing
  // that called bx — a bigger model, or a person — gets the page as jev saw it
  // and takes one decision, then hands control back.
  const last = st[st.length - 1];
  if (['unsure', 'confirm', 'needs-value'].includes(out.reason) && last && last.handoff) {
    console.log(`\n  ${mag('▸ over to you')} ${dim(last.handoff.url)}`);
    for (const e of (last.handoff.elements || []).slice(0, 25)) {
      console.log(`    ${yel(e.ref.padEnd(5))} ${dim((e.tag || '').padEnd(8))} ${trunc(e.name || '', 60)}`);
    }
    console.log(dim(`\n    decide, then continue:  bx click ref=eN   ·   bx agent "<goal>" --yes  ·  bx agent "<the rest of the goal>"`));
  }
  if (out.page && out.page.text) {
    console.log(`\n${bold(out.page.title || '')} ${dim(out.page.url || '')}\n`);
    console.log(out.page.text);
    if (out.page.truncated) console.log(dim('\n… truncated — bx read --max N for more'));
  }
  return out.ok ? 0 : 1;
}

// An ambiguous target is not an error, so it never reaches the red path — but
// it is the single most likely reason a step "worked" and nothing happened.
const amb = (r) =>
  (r && r.n > 1 ? yel(`  ${DOT} ${r.n} matched`) : '') +
  (r && r.inert ? red(`  ${DOT} disabled`) : '') +
  (r && r.healed ? dim(`  ${DOT} ref ${r.healed} was stale, re-found by its text as ${r.ref}`) : '');

function summary(a, r) {
  if (!r || typeof r !== 'object') return dim(String(r ?? ''));
  if (r.path) return `${blu(r.path)} ${dim(`${(r.bytes / 1024).toFixed(0)}kb`)}`;
  if (r.inline) return dim(`${(r.bytes / 1024).toFixed(0)}kb base64 inline`);
  if (a === 'read') return `${dim(trunc(r.title, 50))} ${dim(`${r.len} chars`)}`;
  if (a === 'elements') return dim(`${r.n} elements`);
  if (a === 'tabs') return dim(`${r.n} tabs`);
  if (a === 'fill') return `${r.filled}/${r.of} fields`;
  // Never shorten a URL. A caller reads filters and ids out of it, and they
  // sit at the end: Fiverr's seller-country filter was the part cut off.
  if (r.url) return dim(r.url);
  if (r.at) return dim(`@ ${r.at[0]},${r.at[1]}${r.trusted ? mag(' trusted') : ''}${r.covered ? yel(' covered') : ''}`);
  if (r.value !== undefined) return dim(trunc(JSON.stringify(r.value), 110));
  if (r.y !== undefined && r.max !== undefined) return dim(`y=${r.y}/${r.max}${r.atBottom ? ' (bottom)' : ''}`);
  return dim(trunc(JSON.stringify(r), 110));
}

function detail(a, r) {
  if (r && r.alt) for (const o of r.alt) {
    console.log(`  ${dim('also')} ${yel(o.ref.padEnd(5))} ${trunc(o.css, 88)}${o.dis ? red(' disabled') : ''}`);
  }
  if (a === 'read' && r.text) console.log('\n' + r.text + '\n');
  if (a === 'elements') for (const e of r.elements) {
    console.log(`  ${yel(e.ref.padEnd(5))} ${dim(e.tag.padEnd(8))} ${trunc(e.name || '', 58).padEnd(58)} ${dim(`${e.box[0]},${e.box[1]}`)}${e.dis ? red(' disabled') : ''}`);
  }
  if (a === 'tabs') for (const t of r.tabs) {
    console.log(`  ${(t.active ? grn('▸') : ' ')} ${yel(String(t.id).padEnd(6))} ${trunc(t.title, 46).padEnd(46)} ${dim(t.url)}`);
  }
  if (a === 'read' && r.links) for (const l of r.links) console.log(`  ${trunc(l.text, 44).padEnd(44)} ${dim(l.href)}`);
  if (a === 'fill') for (const d of r.detail) if (!d.ok) console.log(`  ${BAD} ${d.sel} ${red(trunc(d.error, 80))}`);
}

// --see forces a screenshot into the jev call, --no-see forbids one; neither
// leaves it to the bridge (by default: only when the text answer is shaky).
const see = () => (flags['no-see'] ? false : flags.see ? true : undefined);
const eye = (r) => (r && r.saw ? mag(' 👁') : '');

const run = async (actions) => process.exit(render(await api('POST', '/do', { ...common(), actions })));

// Reads wait for the page to finish loading and go quiet first. Without this
// a caller that just clicked has to guess, and every model guesses the same
// way: `sleep 3 && bx read`, three seconds a step whether they were needed or
// not. --no-wait skips it.
const settled = async (actions) => {
  if (flags['no-wait']) return run(actions);
  const out = await api('POST', '/do', { ...common(), actions: [{ a: 'wait', settle: true, timeout: 4000 }, ...actions] });
  // Drop the wait only when it worked. A failed one is the whole answer —
  // an error page, a dead tab — and hiding it printed nothing at all.
  if (out.results && out.results[0]?.a === 'wait' && (out.results[0].ok || out.results.length > 1)) out.results.shift();
  process.exit(render(out));
};

// ── commands ─────────────────────────────────────────────────────────────
const HELP = `
