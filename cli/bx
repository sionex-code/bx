const target = (i = 0) => {
  const sel = args[i];
  if (flags.has === undefined && flags.near === undefined && flags.nth === undefined) return sel;
  const t = { sel };
  if (flags.has !== undefined) t.has = String(flags.has);
  if (flags.near !== undefined) t.near = String(flags.near);
  if (flags.nth !== undefined) t.nth = num(flags.nth);
  return t;
};


// ── many pages: time-boxed, streamed, resumable ─────────────────────────
// The run this replaces: 570 Facebook groups read in batches of 50, each batch
// silent until its last page, and the agent's shell killing any command past
// 120s — so a batch either finished or vanished, and one hung tab stalled the
// session until the user asked why it was stuck. Now each page prints the
// moment it lands, goes into a journal on disk, and the call stops starting
// pages after --budget seconds (default 75). Running the same command again
// skips everything already in the journal, so "continue" is just "again".
function journalFor(kind, key, urls) {
  const h = require('crypto').createHash('sha1').update(`${kind}\n${key}\n${[...urls].sort().join('\n')}`).digest('hex').slice(0, 12);
  return flags.out ? path.resolve(flags.out) : path.join(HOME, 'runs', `${kind}-${h}.jsonl`);
}

async function manyUrls(kind, route, key, urls, payload, show) {
  urls = [...new Set(urls)];
  const file = journalFor(kind, key, urls);
  const prior = new Map();
  if (!flags.fresh) {
    try {
      for (const l of fs.readFileSync(file, 'utf8').split('\n')) {
        if (!l.trim()) continue;
        try { const x = JSON.parse(l); if (!x.error) prior.set(x.asked || x.url, x); } catch {}
      }
    } catch {}
  }
  const todo = urls.filter((u) => !prior.has(u));
  const budget = flags.budget === undefined ? 75 : Number(flags.budget);
  const par = Math.max(1, Math.min(num(flags.parallel) || 6, 12));
  try { fs.mkdirSync(path.dirname(file), { recursive: true }); } catch {}
  if (prior.size && !flags.json) console.log(dim(`resuming · ${prior.size} of ${urls.length} already done, in ${file}`));
  if (!todo.length) {
    if (flags.json) { console.log(JSON.stringify({ ok: true, n: urls.length, journal: file, results: urls.map((u) => prior.get(u)) }, null, 2)); return 0; }
    console.log(`${OK} all ${urls.length} pages already done ${dim(`— results in ${file}  (--fresh to redo)`)}`);
    return 0;
  }
  if (!flags.json) {
    const est = Math.round((todo.length / par) * 8);   // Facebook tabs measured at 5–14s each
    console.log(dim(`${todo.length} pages · ${par} at a time · ~${est}s${budget && est > budget ? ` · this call stops at ${budget}s, run it again to continue` : ''}`));
  }
  const fresh = [];
  const end = await stream(route, { ...payload, urls: todo, parallel: par, budget: budget ? budget * 1000 : 0, stream: true }, (x) => {
    delete x.t;
    fresh.push(x);
    try { fs.appendFileSync(file, JSON.stringify(x) + '\n'); } catch {}
    if (!flags.json) show(x);
  });
  if (end.ok === false && end.error) die(end.error);
  const errs = fresh.filter((x) => x.error).length;
  const left = end.skipped?.length || 0;
  const all = new Map([...prior, ...fresh.filter((x) => !x.error).map((x) => [x.asked || x.url, x])]);
  if (flags.json) {
    console.log(JSON.stringify({ ok: true, n: urls.length, done: all.size, left, errors: errs, journal: file,
      results: urls.map((u) => all.get(u) || fresh.find((x) => (x.asked || x.url) === u) || { url: u, skipped: true }) }, null, 2));
  } else {
    console.log(dim(`\n${fresh.length - errs} pages in ${secs(end.ms || 0)} · ${par} at a time${errs ? ` · ${errs} failed` : ''} · ${all.size}/${urls.length} done · journal ${file}`));
    if (left || errs) console.log(`  ${mag('▸')} ${bold(`${left + errs} left`)} ${dim('— run the exact same command again; finished pages are skipped, failed ones retried')}`);
    else if (prior.size) console.log(`  ${mag('▸')} ${dim(`complete — earlier pages are in the journal, one JSON object per line`)}`);
  }
  return left || errs ? 3 : 0;
}

